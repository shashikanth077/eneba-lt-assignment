# XAMPP on Windows/macOS/Linux. Copy to backend/.env:   copy .env.xampp.example .env
# Everything below is a development value. See docs/XAMPP.md.
APP_ENV=local
APP_DEBUG=true

# XAMPP's MySQL/MariaDB: user root, EMPTY password, port 3306. Use 127.0.0.1, not "localhost" (avoids a socket lookup that fails on Windows).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keymart
DB_USER=root
DB_PASS=
# auto = SKIP LOCKED when the server has it (MariaDB 10.6+/MySQL 8.0.1+), plain FOR UPDATE otherwise (XAMPP with MariaDB 10.4/10.5).
LOCK_STRATEGY=auto

# --- Option A: PHP's built-in server (php -S localhost:8080 -t public public/index.php). Leave APP_BASE_PATH empty.
# --- Option B: Apache serving the project from htdocs, e.g. C:\xampp\htdocs\keymart:
#     the API is then http://localhost/keymart/backend/public/api/... -> set the folder part here (no trailing slash):
APP_BASE_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Generate with XAMPP's php:  php -r "echo bin2hex(random_bytes(32));"   (at least 32 characters)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=86400
COOKIE_SECURE=false
TRUST_PROXY=false
# Handy while running the frontend/e2e browser scripts, which register many users from this machine (docs/REVIEW.md S3):
RATE_LIMITS_ENABLED=true

# Dev-only example key. Generate your own: php -r "echo base64_encode(random_bytes(32));"
KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZC0=

# none = homepage blocks read fresh data on every request, so a database edit shows on refresh (best while developing).
# file = cache each block for up to 10 minutes (what a production server should use).
CACHE_DRIVER=none

# Stripe TEST keys only (sk_test_...). Webhook secret from `stripe listen` (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_CURRENCY=eur
RESERVATION_MINUTES=15
