# Copy to backend/.env for running without Docker. In Docker Compose these come from docker-compose.yml.
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keymart
DB_USER=keymart
DB_PASS=keymart

# Comma-separated list of browser origins allowed to call the API cross-origin (local dev only).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public URL of the frontend (CSRF Origin allow-list). Production: the Vercel URL.
APP_URL=http://localhost:5173

# PUBLIC DEPLOYMENTS: the JWT_SECRET and KEY_ENCRYPTION_KEY below are published in this repository. The app REFUSES TO START with them
# once APP_URL is a real address (docs/REVIEW.md S2); it also refuses COOKIE_SECURE=false and APP_DEBUG=true there.
# Session JWT. Generate: php -r 'echo bin2hex(random_bytes(32));'  (>= 32 characters, keep secret)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=86400
# Browsers only send Secure cookies over HTTPS (localhost counts as secure in Chrome/Firefox, curl does not).
# Use false for local http testing, true in production.
COOKIE_SECURE=false
# true only when running behind a trusted proxy (Render): then X-Forwarded-For is used for rate limiting.
# TRUSTED_PROXY_HOPS is how many proxies append to that header (Render: 1). The client is the entry that many places from the RIGHT;
# the left side is client-controlled and is never trusted (docs/REVIEW.md S1).
TRUST_PROXY=false
# TRUSTED_PROXY_HOPS=1
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# Encrypts game keys at rest: base64 of 32 random bytes. Generate: php -r 'echo base64_encode(random_bytes(32));'
# The value below is a DEV-ONLY example; never reuse it outside local development.
KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZC0=

# Homepage block cache: file (default) or none. Each block caches under its own folder inside CACHE_DIR.
CACHE_DRIVER=file
# CACHE_DIR=/tmp/keymart-cache

# --- Payments (Stripe TEST mode only) ---
# Keys: https://dashboard.stripe.com/test/apikeys   (sk_test_... only; never put a live key anywhere)
STRIPE_SECRET_KEY=
# Local: run `stripe listen --forward-to localhost:8080/api/webhooks/stripe` and paste the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=
CHECKOUT_CURRENCY=eur
# How long checkout holds the keys while the buyer pays
RESERVATION_MINUTES=15

# How checkout locks keys: auto (default), skip (FOR UPDATE SKIP LOCKED) or wait (plain FOR UPDATE, for MariaDB < 10.6).
# LOCK_STRATEGY=auto
# Only when Apache serves the API from a subfolder, e.g. /keymart/backend/public (see docs/XAMPP.md).
# APP_BASE_PATH=

# Abuse limits (docs/REVIEW.md S3). RATE_LIMITS_ENABLED=false switches them all off, e.g. while running the browser e2e scripts
# (they register many users from one address). The others are requests allowed per window and subject; 0 disables one limit.
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_REGISTER_PER_HOUR=10      per IP address
# RATE_LIMIT_CHECKOUT_PER_10MIN=10     per signed-in account
# RATE_LIMIT_SEARCH_PER_MINUTE=240     per IP address, /api/search and /api/search/suggest together

# E-mail through EmailJS (docs/EMAIL.md). The API sends the verification e-mail itself (the link is a secret), using the AUTH template.
# Needs "Allow EmailJS API for non-browser applications" in the EmailJS dashboard. Leave empty to skip e-mails.
EMAILJS_SERVICE_ID=
EMAILJS_AUTH_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
MAIL_COMPANY_NAME=KEYMART
SUPPORT_EMAIL=support@keymart.example
EMAIL_VERIFICATION_TTL_HOURS=24
