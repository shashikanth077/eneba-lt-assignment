# Copy to backend/.env for running without Docker. In Docker Compose these come from docker-compose.yml.
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keymart
DB_USER=keymart
DB_PASS=keymart

# Comma-separated list of browser origins allowed to call the API cross-origin (local dev only).
CORS_ALLOWED_ORIGINS=http://localhost:5173
