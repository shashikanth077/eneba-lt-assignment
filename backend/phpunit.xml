<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unit"><directory>tests</directory></testsuite>
    </testsuites>
    <php>
        <!-- Test-only values. Real DB credentials still come from the environment / .env. -->
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="LOG_LEVEL" value="off" force="true"/> <!-- tests that look at the log switch it on and capture it (LogTest) -->
        <env name="JWT_SECRET" value="phpunit-secret-phpunit-secret-phpunit-secret" force="true"/>
        <env name="COOKIE_SECURE" value="true" force="true"/>
        <env name="APP_URL" value="http://localhost:5173" force="true"/>
        <env name="TRUST_PROXY" value="false" force="true"/>
        <env name="CACHE_DRIVER" value="none" force="true"/>
        <env name="STRIPE_SECRET_KEY" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_phpunit_only_secret" force="true"/>
        <env name="RESERVATION_MINUTES" value="15" force="true"/>
        <env name="CHECKOUT_CURRENCY" value="eur" force="true"/>
        <!-- Generous so ordinary tests never meet a limit; RateLimitTest lowers them on purpose. -->
        <env name="RATE_LIMIT_REGISTER_PER_HOUR" value="100000" force="true"/>
        <env name="RATE_LIMIT_CHECKOUT_PER_10MIN" value="100000" force="true"/>
        <env name="RATE_LIMIT_SEARCH_PER_MINUTE" value="100000" force="true"/>
        <env name="KEY_ENCRYPTION_KEY" value="ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZC0=" force="true"/>
    </php>
</phpunit>
