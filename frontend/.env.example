# Where the dev server proxies /api. Docker Compose sets this to http://php.
VITE_API_PROXY_TARGET=http://localhost:8080

# Stripe TEST publishable key (pk_test_...). Safe to expose; the SECRET key stays in backend/.env.
VITE_STRIPE_PUBLISHABLE_KEY=

# EmailJS (https://www.emailjs.com): service + two templates. The public key is public by design; emails carry no game keys.
# Welcome template variables: {{to_email}} {{to_name}}.  Order template: {{to_email}} {{to_name}} {{order_id}} {{order_items}} {{order_total}}.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=

# Optional: another API origin/path (default: same-origin /api, proxied by Vite in development and rewritten by the host in production).
# VITE_API_BASE_URL=/api
