# Where the dev server proxies /api. Docker Compose sets this to http://php.
VITE_API_PROXY_TARGET=http://localhost:8000

# Stripe TEST publishable key (pk_test_...). Safe to expose; the SECRET key stays in backend/.env.
VITE_STRIPE_PUBLISHABLE_KEY=

# EmailJS (https://www.emailjs.com): one service and exactly two templates (docs/EMAIL.md). The public key is public by design;
# the PRIVATE key is only in backend/.env. E-mails carry no game keys.
#   AUTH template  = welcome AND email verification (same template, different variables)
#   ORDER template = order confirmation
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_AUTH_TEMPLATE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
# Shown in the e-mails (defaults: KEYMART, support@keymart.example)
# VITE_COMPANY_NAME=KEYMART
# VITE_SUPPORT_EMAIL=support@your-domain.example

# Optional: another API origin/path (default: same-origin /api, proxied by Vite in development and rewritten by the host in production).
# VITE_API_BASE_URL=/api
