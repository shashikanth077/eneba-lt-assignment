# Used by docker-compose.yml only (variable substitution). All values have defaults,
# so copying this file is optional. Never put real secrets in the committed example.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=keymart
MYSQL_USER=keymart
MYSQL_PASSWORD=keymart
# Optional overrides for the dev-only secrets in docker-compose.yml:
# JWT_SECRET=
# KEY_ENCRYPTION_KEY=

# Stripe TEST keys (optional until you want to pay): copied into the php container by docker-compose.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
